# Database connection used by Prisma Client and database migrations.
# If you add Vercel Postgres (Neon), this can be the POSTGRES_PRISMA_URL value.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"
# Optional legacy setting; the Prisma schema no longer requires DIRECT_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-string"

# "demo" uses a label-only heuristic classifier with no external calls.
# "model" calls an external image-classification API using the keys below.
AI_CLASSIFIER_MODE="demo"
AI_CLASSIFIER_API_KEY=""
AI_CLASSIFIER_API_URL=""
